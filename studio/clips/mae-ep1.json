  "subs": [
    {
      "s": 0.01,
      "e": 1.45,
      "text": "ป้าแดงบอกฟ้าว่า"
    },
    {
      "s": 1.4,
      "e": 3.97,
      "text": "\"ไม่มีใครเก่งเท่า*แม่มึง*อีกแล้ว\""
    },
    {
      "s": 4.75,
      "e": 6.0,
      "text": "ฟ้าได้ยินประโยคนี้มา"
    },
    {
      "s": 5.95,
      "e": 7.98,
      "text": "*ตั้งแต่เด็ก*จนจำขึ้นใจ"
    },
    {
      "s": 8.53,
      "e": 10.44,
      "text": "แต่ตอนนี้ฟ้าเป็น*นักออกแบบ*"
    },
    {
      "s": 10.39,
      "e": 12.535,
      "text": "ในกรุงเทพ งานไปได้สวย"
    },
    {
      "s": 13.37,
      "e": 14.88,
      "text": "คืนหนึ่ง แม่โทรมาชวน"
    },
    {
      "s": 14.83,
      "e": 16.75,
      "text": "กลับบ้าน ไป*งานผ้าป่า*"
    },
    {
      "s": 17.35,
      "e": 19.02,
      "text": "ฟ้า*ลังเล*เพราะทุกครั้งที่"
    },
    {
      "s": 18.97,
      "e": 20.71,
      "text": "กลับก็โดนเทียบกับแม่"
    },
    {
      "s": 21.19,
      "e": 22.99,
      "text": "แต่สุดท้ายก็*กลับมา*เพราะ"
    },
    {
      "s": 22.94,
      "e": 24.97,
      "text": "เสียงแม่ฟังเหนื่อยกว่าที่เคย"
    },
    {
      "s": 25.53,
      "e": 27.1,
      "text": "แม่ศรีไม่ถามเรื่องงาน"
    },
    {
      "s": 27.05,
      "e": 29.36,
      "text": "ถามก่อนว่า \"*กินข้าวยัง*\""
    },
    {
      "s": 30.07,
      "e": 31.765,
      "text": "บ้าน*เรียบร้อย*ทุกมุมทั้งที่"
    },
    {
      "s": 31.715,
      "e": 33.9,
      "text": "ไม่มีใครเห็นแม่ลงมือ"
    },
    {
      "s": 34.05,
      "e": 35.93,
      "text": "ตีสี่ แม่ก็ตื่นก่อไฟ"
    },
    {
      "s": 35.88,
      "e": 37.51,
      "text": "หุงข้าวไว้ให้*งานวัด*"
    },
    {
      "s": 38.05,
      "e": 39.65,
      "text": "แม่รู้ว่าใคร*แพ้อะไร*"
    },
    {
      "s": 39.6,
      "e": 41.485,
      "text": "ใครไม่กินเผ็ดทั้งซอย"
    },
    {
      "s": 41.9,
      "e": 43.625,
      "text": "ไม่ใช่เรื่องใหญ่โต เป็นแค่"
    },
    {
      "s": 43.575,
      "e": 45.94,
      "text": "เรื่องธรรมดา ที่ฟ้า*มองข้าม*"
    },
    {
      "s": 46.51,
      "e": 47.58,
      "text": "ลานวัดเต็มไปด้วย"
    },
    {
      "s": 47.53,
      "e": 49.34,
      "text": "คนที่*เคยกินข้าวแม่*"
    },
    {
      "s": 49.85,
      "e": 51.23,
      "text": "ทุกคน*ชมแม่*ต่อหน้า"
    },
    {
      "s": 51.18,
      "e": 52.48,
      "text": "ฟ้าด้วยความรัก"
    },
    {
      "s": 52.8,
      "e": 54.66,
      "text": "แต่ฟ้าฟังแล้วรู้สึกเหมือน"
    },
    {
      "s": 54.61,
      "e": 56.58,
      "text": "มี*ไม้บรรทัด*วางข้างตัว"
    },
    {
      "s": 57.11,
      "e": 58.95,
      "text": "ตอนเด็กฟ้าเคยชนะประกวด"
    },
    {
      "s": 58.9,
      "e": 60.45,
      "text": "วาดภาพของโรงเรียน"
    },
    {
      "s": 60.86,
      "e": 62.37,
      "text": "เธอวาดภาพ*แม่หุงข้าว*"
    },
    {
      "s": 62.32,
      "e": 64.55,
      "text": "อย่างภูมิใจแล้วชูให้ครูดู"
    },
    {
      "s": 65.08,
      "e": 66.31,
      "text": "ครูหัวเราะแล้วว่า"
    },
    {
      "s": 66.26,
      "e": 68.83,
      "text": "\"ไม่มีใครเก่งเท่า*แม่มึง*อีกแล้ว\""
    },
    {
      "s": 69.43,
      "e": 70.87,
      "text": "รางวัลของเธอไม่มีใคร"
    },
    {
      "s": 70.82,
      "e": 73.19,
      "text": "พูดถึง มีแต่แม่ที่ถูกชม"
    },
    {
      "s": 73.81,
      "e": 75.425,
      "text": "คืนนั้นฟ้านอนในห้อง"
    },
    {
      "s": 75.375,
      "e": 77.26,
      "text": "เก่าคิดถึง*ประโยคนั้น*"
    },
    {
      "s": 77.75,
      "e": 81.02,
      "text": "ฟ้าคิดว่า*สิ่งที่แม่ทำ*ใครก็ทำได้"
    },
    {
      "s": 81.4,
      "e": 83.33,
      "text": "แต่ถ้าใครก็ทำได้ทำไม"
    },
    {
      "s": 83.28,
      "e": 84.98,
      "text": "ฟ้าถึง*ไม่เคยเท่า*แม่"
    },
    {
      "s": 85.67,
      "e": 87.05,
      "text": "เช้าวันงานทุกคน"
    },
    {
      "s": 87.0,
      "e": 88.67,
      "text": "ช่วยกัน*ยกหม้อ*ใบใหญ่"
    },
    {
      "s": 89.19,
      "e": 90.63,
      "text": "แม่ยื่น*หม้อข้าว*ให้ฟ้า"
    },
    {
      "s": 90.58,
      "e": 92.27,
      "text": "ช่วยยกไปวางที่โต๊ะ"
    },
    {
      "s": 92.59,
      "e": 94.41,
