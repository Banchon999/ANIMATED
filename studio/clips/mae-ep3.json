  "subs": [
    {
      "s": 0.04,
      "e": 0.922,
      "text": "ฟ้าเหลือเวลาอีก"
    },
    {
      "s": 0.872,
      "e": 2.41,
      "text": "*สองวัน*ที่ต้องตอบ"
    },
    {
      "s": 2.91,
      "e": 4.14,
      "text": "แม่ซ่อนเรื่องป่วย"
    },
    {
      "s": 4.09,
      "e": 6.12,
      "text": "และทั้งซอย*ช่วยกันปิด*"
    },
    {
      "s": 6.79,
      "e": 8.865,
      "text": "เช้าถัดมา ฟ้าเดิน*ตามแม่*"
    },
    {
      "s": 8.815,
      "e": 10.975,
      "text": "*เงียบ* ๆ ทั้งวันโดยไม่ให้รู้"
    },
    {
      "s": 11.61,
      "e": 13.11,
      "text": "บ้านแรก แม่ถามถึง"
    },
    {
      "s": 13.06,
      "e": 14.79,
      "text": "เด็กที่เมื่อคืน*ไข้ขึ้น*"
    },
    {
      "s": 15.35,
      "e": 17.24,
      "text": "บ้านที่สองเจ้าของไม่อยู่"
    },
    {
      "s": 17.19,
      "e": 18.75,
      "text": "แม่ก็กวาดลานให้"
    },
    {
      "s": 19.01,
      "e": 21.5,
      "text": "ไม่มีใครขอ และแทบไม่มีใครเห็น"
    },
    {
      "s": 21.45,
      "e": 23.125,
      "text": "แต่ทุกอย่าง*เรียบร้อย*"
    },
    {
      "s": 23.61,
      "e": 25.285,
      "text": "ที่ตลาด ป้าแดงลดราคา"
    },
    {
      "s": 25.235,
      "e": 26.76,
      "text": "ให้คนที่*เงินไม่พอ*"
    },
    {
      "s": 27.17,
      "e": 28.825,
      "text": "แม่จ่ายส่วนที่ขาดเองแล้ว"
    },
    {
      "s": 28.775,
      "e": 30.698,
      "text": "เดินจากไปเหมือนไม่มีอะไร"
    },
    {
      "s": 31.25,
      "e": 32.695,
      "text": "ฟ้ายืนมองอยู่ไกลลิบ"
    },
    {
      "s": 32.645,
      "e": 34.61,
      "text": "เหมือนเห็นแม่เป็น*ครั้งแรก*"
    },
    {
      "s": 34.65,
      "e": 36.425,
      "text": "ย้อนไป*ยี่สิบปี*ก่อน"
    },
    {
      "s": 36.65,
      "e": 39.0,
      "text": "แม่ก่อไฟตอนตีสี่"
    },
    {
      "s": 38.95,
      "e": 41.365,
      "text": "*ตอนเด็ก* ทุกเช้าฟ้าตื่นมาข้าว"
    },
    {
      "s": 41.315,
      "e": 43.525,
      "text": "ก็สุกแล้ว เหมือน*เกิดขึ้นเอง*"
    },
    {
      "s": 44.01,
      "e": 45.67,
      "text": "คืนนั้นฟ้าเจอภาพวาด"
    },
    {
      "s": 45.62,
      "e": 47.47,
      "text": "เก่าในลิ้นชักตู้ของแม่"
    },
    {
      "s": 47.42,
      "e": 48.93,
      "text": "ภาพที่ไม่มีใครชม"
    },
    {
      "s": 49.31,
      "e": 51.16,
      "text": "แม่เก็บไว้*ยี่สิบปี*"
    },
    {
      "s": 51.71,
      "e": 53.98,
      "text": "แม่เอ่ยเบา ๆ \"ไปเถอะลูก"
    },
    {
      "s": 53.93,
      "e": 55.67,
      "text": "แม่อยากเห็นลูก*ไปให้สุด*\""
    },
    {
      "s": 56.11,
      "e": 58.58,
      "text": "ฟ้าถามว่า \"แล้ว*ใครจะดูแม่*\""
    },
    {
      "s": 58.57,
      "e": 60.46,
      "text": "แม่ไม่ตอบแค่ยิ้ม"
    },
    {
      "s": 60.87,
      "e": 62.835,
      "text": "แม่เอื้อมมือมาลูบหัวฟ้าเบา"
    },
    {
      "s": 62.785,
      "e": 64.07,
      "text": "ๆ เหมือน*ตอนเด็ก*"
    },
    {
      "s": 64.49,
      "e": 65.99,
      "text": "วันสุดท้ายฟ้าไปนั่ง"
    },
    {
      "s": 65.94,
      "e": 67.43,
      "text": "ที่ลานวัด*คนเดียว*"
    },
    {
      "s": 67.71,
      "e": 69.68,
      "text": "ป้าแดงถือชามข้าวมานั่งข้าง ๆ"
    },
    {
      "s": 69.63,
      "e": 71.237,
      "text": "ฟ้า โดย*ไม่ถามอะไร*"
    },
    {
      "s": 71.55,
      "e": 73.095,
      "text": "ป้ามองลานวัดที่ว่างเปล่า"
    },
    {
      "s": 73.045,
      "e": 74.79,
      "text": "อยู่นาน แล้ว*พูดเบา ๆ*"
    },
    {
      "s": 75.42,
      "e": 76.365,
      "text": "\"ไม่มีใครเก่ง"
    },
    {
      "s": 76.315,
      "e": 77.81,
      "text": "เท่า*แม่มึง*อีกแล้ว\""
    },
    {
      "s": 78.36,
      "e": 79.92,
      "text": "ไม่ใช่*ไม้บรรทัด*แต่คือ"
    },
    {
      "s": 79.87,
      "e": 81.99,
      "text": "สิ่งที่ไม่มีใครแทนได้"
    },
    {
      "s": 82.23,
      "e": 84.36,
      "text": "ฟ้าพิมพ์*อีเมล*ถึงที่ทำงานช้า"
