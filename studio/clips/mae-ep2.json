  "subs": [
    {
      "s": 0.03,
      "e": 1.19,
      "text": "ป้าแดงว่า"
    },
    {
      "s": 1.23,
      "e": 3.51,
      "text": "\"ไม่มีใครเก่งเท่า*แม่มึง*อีกแล้ว\""
    },
    {
      "s": 4.01,
      "e": 6.32,
      "text": "แม่ซ่อนใบนัดหมอไว้ใต้หมอน"
    },
    {
      "s": 6.8,
      "e": 9.26,
      "text": "เช้านั้นฟ้าเก็บที่นอนให้แม่"
    },
    {
      "s": 9.235,
      "e": 10.96,
      "text": "แล้วก็เจอใบนัดใบนั้น"
    },
    {
      "s": 11.53,
      "e": 12.751,
      "text": "ใบนัด*คลินิก*ระบบประสาท"
    },
    {
      "s": 12.701,
      "e": 14.66,
      "text": "วันอังคารหน้า"
    },
    {
      "s": 14.61,
      "e": 16.42,
      "text": "ฟ้าถือใบนัด*วิ่งไปถาม*"
    },
    {
      "s": 16.37,
      "e": 18.17,
      "text": "ป้าแดงทันทีที่เห็นหน้า"
    },
    {
      "s": 18.71,
      "e": 20.737,
      "text": "ป้าแดงนิ่งไปนานแล้วพูดว่า"
    },
    {
      "s": 20.687,
      "e": 22.84,
      "text": "*ทุกคน*ในซอยรู้กันหมด"
    },
    {
      "s": 23.23,
      "e": 25.223,
      "text": "ทุกคนรู้*ยกเว้นฟ้า*"
    },
    {
      "s": 25.172,
      "e": 27.15,
      "text": "เธอโกรธจนเสียงสั่น"
    },
    {
      "s": 27.55,
      "e": 28.675,
      "text": "ป้าแดงตอบ"
    },
    {
      "s": 28.625,
      "e": 30.98,
      "text": "\"ไม่มีใครเก่งเท่า*แม่มึง*อีกแล้ว\""
    },
    {
      "s": 31.22,
      "e": 32.7,
      "text": "แล้วถามกลับว่า"
    },
    {
      "s": 32.66,
      "e": 34.64,
      "text": "ใครจะกล้าบอกว่าแม่*ไม่ไหว*"
    },
    {
      "s": 35.13,
      "e": 36.34,
      "text": "ป้าแดงยื่นสมุดเล่ม"
    },
    {
      "s": 36.29,
      "e": 38.5,
      "text": "เก่าที่แม่จดไว้ให้ฟ้า"
    },
    {
      "s": 38.52,
      "e": 41.108,
      "text": "ชื่อคนทั้งซอย ใคร*แพ้อะไร*"
    },
    {
      "s": 41.45,
      "e": 43.16,
      "text": "ใครกินยาเวลาไหน"
    },
    {
      "s": 43.24,
      "e": 44.84,
      "text": "ลายมือในหน้าหลังค่อย ๆ"
    },
    {
      "s": 44.79,
      "e": 46.27,
      "text": "*สั่นขึ้น*ทีละหน้า"
    },
    {
      "s": 46.65,
      "e": 48.25,
      "text": "ตีสี่วันต่อมา"
    },
    {
      "s": 48.4,
      "e": 50.72,
      "text": "ฟ้าลอง*หุงข้าวแทนแม่*เอง"
    },
    {
      "s": 50.67,
      "e": 52.405,
      "text": "ไฟแรงไป ข้าวไหม้ติด"
    },
    {
      "s": 52.355,
      "e": 54.65,
      "text": "หม้อทั้งหม้อ ควันตลบ"
    },
    {
      "s": 54.6,
      "e": 56.91,
      "text": "ป้าแดงมาเห็นก็หัวเราะทั้งน้ำตา"
    },
    {
      "s": 57.43,
      "e": 58.993,
      "text": "\"*แม่ไม่เคยไหม้*เลย\""
    },
    {
      "s": 59.13,
      "e": 61.86,
      "text": "ฟ้านั่งลงกับพื้น เพิ่ง*เข้าใจ*ว่า"
    },
    {
      "s": 61.92,
      "e": 63.7,
      "text": "ข้าวหม้อเดียวก็ยาก"
    },
    {
      "s": 63.65,
      "e": 64.845,
      "text": "วันอังคาร"
    },
    {
      "s": 65.21,
      "e": 66.9,
      "text": "ฟ้าพาแม่ไป*โรงพยาบาล*"
    },
    {
      "s": 66.85,
      "e": 68.21,
      "text": "แม่พูดเบา ๆ ว่า"
    },
    {
      "s": 68.16,
      "e": 71.425,
      "text": "\"อย่าบอกลูกเลย เดี๋ยว*ลูกเสียงาน*\""
    },
    {
      "s": 71.39,
      "e": 72.76,
      "text": "มือที่เคยหั่นผักเร็ว"
    },
    {
      "s": 72.71,
      "e": 75.17,
      "text": "ที่สุดในซอย ตอนนี้สั่น"
    },
    {
      "s": 75.12,
      "e": 76.625,
      "text": "หมอบอกว่า*ไม่หาย*"
    },
    {
      "s": 76.84,
      "e": 79.03,
      "text": "แต่ดูแลได้ถ้ามีคนอยู่ใกล้"
    },
    {
      "s": 78.98,
      "e": 80.64,
      "text": "คนชมแม่ทั้งซอย"
    },
    {
      "s": 80.8,
      "e": 82.82,
      "text": "แต่*ไม่มีใครถาม*ว่าเหนื่อยไหม"
    },
    {
      "s": 82.77,
      "e": 84.395,
      "text": "โทรศัพท์ดัง ที่ทำงาน"
    },
    {
      "s": 84.345,
      "e": 86.4,
      "text": "*เสนอ*ตำแหน่งที่สิงคโปร์"
    },
    {
      "s": 86.35,
      "e": 87.56,
      "text": "ตอบภายในวันศุกร์"
    },
    {
      "s": 87.51,
      "e": 90.19,
      "text": "ฝันที่ฟ้ารอมาแปดปี"
    },
    {
      "s": 90.2,
      "e": 93.44,
      "text": "แม่ยิ้มพลางบอก \"ไปเถอะ*แม่อยู่ได้*\""
    },
    {
